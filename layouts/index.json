{{- $.Scratch.Add "index" slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) (ne .Layout `page`) }}
    {{- $.Scratch.Add "index" (dict 
        "title" .Title 
        "content" .Plain 
        "permalink" .Permalink 
        "summary" (.Params.summary | default (.Plain | truncate 150))
        "date" (.Date.Format "2006-01-02")
        "tags" .Params.tags
        "categories" .Params.categories
        "series" .Params.series
    ) -}}
    {{- end }}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
